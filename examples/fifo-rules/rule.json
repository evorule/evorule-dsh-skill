{
  "$schema": "https://evorule.org/schemas/rule_set/v1.0.json",
  "kind": "rule_set",
  "id": "app.dsh.fifo_rules",
  "version": "0.1.0",
  "metadata": {
    "title": "dsh-skill fifo example",
    "description": "指令队列示例：push 指令层 step1/step2 入队，branch 按指令类型分别置 order，演示 push 队列语义。",
    "license": "AGPL-3.0-or-later"
  },
  "transform": [
    {
      "type": "branch",
      "params": {
        "domain": {
          "type": "instruction",
          "instruction_type": "noop"
        },
        "on_true": [
          {
            "type": "push",
            "params": {
              "instructions": [
                {"type": "step1"},
                {"type": "step2"}
              ]
            }
          }
        ]
      }
    },
    {
      "type": "branch",
      "params": {
        "domain": {
          "type": "instruction",
          "instruction_type": "step1"
        },
        "on_true": [
          {
            "type": "set",
            "params": {
              "attr": "order",
              "operation": "set",
              "value": "first"
            }
          }
        ]
      }
    },
    {
      "type": "branch",
      "params": {
        "domain": {
          "type": "instruction",
          "instruction_type": "step2"
        },
        "on_true": [
          {
            "type": "set",
            "params": {
              "attr": "order",
              "operation": "set",
              "value": "second"
            }
          }
        ]
      }
    }
  ]
}
